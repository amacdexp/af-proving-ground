{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "af-proving-ground/build/v1",
  "title": "One build of the substrate",
  "type": "object",
  "required": ["schema", "build_id", "official", "date", "harness", "model", "session", "tokens", "cost", "outcome", "artefact"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "af-proving-ground/build/v1" },
    "build_id": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9-]+$" },
    "official": { "type": "boolean" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "harness": {
      "type": "object", "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "model": {
      "type": "object", "required": ["requested", "served", "reasoning"],
      "properties": {
        "requested": { "type": "string", "minLength": 1 },
        "served": { "type": "string", "minLength": 1 },
        "reasoning": { "enum": ["off", "low", "medium", "high", "max"] }
      }
    },
    "session": {
      "type": "object", "required": ["assistant_turns", "wall_clock_s", "human_interventions"],
      "properties": {
        "assistant_turns": { "type": "integer", "minimum": 1 },
        "wall_clock_s": { "type": "integer", "minimum": 1 },
        "human_interventions": { "type": "integer", "minimum": 0 }
      }
    },
    "tokens": {
      "type": "object",
      "required": ["prompt_total", "input_fresh", "cache_read", "cache_write", "output"],
      "properties": {
        "prompt_total": { "type": "integer", "minimum": 0 },
        "input_fresh": { "type": ["integer", "null"], "minimum": 0 },
        "cache_read": { "type": ["integer", "null"], "minimum": 0 },
        "cache_write": { "type": ["integer", "null"], "minimum": 0 },
        "output": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "cost": {
      "type": "object", "required": ["source"],
      "properties": {
        "billed_usd": { "type": ["number", "null"], "minimum": 0 },
        "estimated_usd": { "type": ["number", "null"], "minimum": 0 },
        "source": { "enum": ["provider-invoice", "harness-report", "rate-table", "unavailable"] },
        "rate_table_date": { "type": ["string", "null"] }
      }
    },
    "outcome": {
      "type": "object", "required": ["build_completed", "spec_check", "baseline", "rebuild_rounds"],
      "properties": {
        "build_completed": { "type": "boolean" },
        "spec_check": { "enum": ["pass", "fail", "not-run"] },
        "baseline": { "type": "string", "description": "n/6 as measured by tools/baseline.py" },
        "rebuild_rounds": { "type": "integer", "minimum": 0 }
      }
    },
    "artefact": {
      "type": "object", "required": ["commit", "files", "loc", "tests", "gate_runtime_s"],
      "properties": {
        "commit": { "type": ["string", "null"], "pattern": "^[0-9a-f]{7,40}$" },
        "files": { "type": ["integer", "null"], "minimum": 0 },
        "loc": { "type": ["integer", "null"], "minimum": 0 },
        "tests": { "type": ["integer", "null"], "minimum": 0 },
        "gate_runtime_s": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "supersedes": { "type": ["string", "null"] },
    "notes": { "type": "string" }
  }
}
