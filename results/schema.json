{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "af-proving-ground/result/v1",
  "title": "One proving-ground run",
  "type": "object",
  "required": ["task", "arm", "harness", "model", "environment", "outcome", "economy", "review", "void"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "af-proving-ground/result/v1" },
    "task": {
      "type": "object",
      "required": ["tag", "commit"],
      "properties": {
        "tag": { "type": "string", "pattern": "^task/v[0-9]+$" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" }
      }
    },
    "arm": {
      "type": "object",
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string", "pattern": "^A[0-9]+$" },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "harness": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "config": { "type": "string" }
      }
    },
    "model": {
      "type": "object",
      "required": ["requested", "served", "reasoning"],
      "properties": {
        "requested": { "type": "string", "minLength": 1 },
        "served": { "type": "string", "minLength": 1, "description": "The model id the provider actually served. An alias is not a model id." },
        "reasoning": { "enum": ["off", "low", "medium", "high", "max"] }
      }
    },
    "environment": {
      "type": "object",
      "required": ["date", "os", "python"],
      "properties": {
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "os": { "type": "string" },
        "python": { "type": "string" }
      }
    },
    "outcome": {
      "type": "object",
      "required": ["acceptance", "held_out"],
      "properties": {
        "acceptance": { "enum": ["pass", "partial", "fail"] },
        "held_out": {
          "type": "object",
          "required": ["passed", "total"],
          "properties": {
            "passed": { "type": "integer", "minimum": 0 },
            "total": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "economy": {
      "type": "object",
      "required": ["turns", "wall_clock_s", "model_spend_usd", "context"],
      "properties": {
        "turns": { "type": "integer", "minimum": 0 },
        "wall_clock_s": { "type": "number", "minimum": 0 },
        "model_spend_usd": { "type": "number", "minimum": 0 },
        "context": {
          "type": "object",
          "required": ["prompt_tokens", "cache_read", "cache_write", "output", "compactions"],
          "properties": {
            "prompt_tokens": { "type": "integer", "minimum": 0 },
            "cache_read": { "type": "integer", "minimum": 0 },
            "cache_write": { "type": "integer", "minimum": 0 },
            "output": { "type": "integer", "minimum": 0 },
            "compactions": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "review": {
      "type": "object",
      "required": ["defects_found", "rework_files", "rework_lines"],
      "properties": {
        "defects_found": { "type": "integer", "minimum": 0 },
        "rework_files": { "type": "integer", "minimum": 0 },
        "rework_lines": { "type": "integer", "minimum": 0 }
      }
    },
    "operator_score": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
    "void": { "type": "boolean" },
    "void_reason": { "type": ["string", "null"] },
    "notes": { "type": "string" }
  }
}
